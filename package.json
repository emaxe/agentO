{
  "name": "@emaxe/agento",
  "version": "0.7.0",
  "description": "Manage AI agent configurations with profiles and providers",
  "author": "emaxe",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "configuration",
    "claude",
    "codex",
    "qwen",
    "opencode",
    "profile",
    "provider",
    "terminal",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxe/agentO.git"
  },
  "bugs": {
    "url": "https://github.com/emaxe/agentO/issues"
  },
  "homepage": "https://github.com/emaxe/agentO#readme",
  "type": "module",
  "bin": {
    "agento": "dist/bin/agento.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build && node dist/bin/agento.js --version && npm test",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src bin",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "react": "^18.3.1",
    "smol-toml": "^1.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "ink-testing-library": "^3.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
