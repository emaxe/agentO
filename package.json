{
  "name": "@emaxe/agento",
  "version": "0.14.1",
  "description": "Launch AI coding agents with reusable model profiles, API providers, and safe config backup and restore.",
  "author": "emaxe",
  "license": "MIT",
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agents",
    "cli",
    "tui",
    "terminal",
    "configuration",
    "profiles",
    "providers",
    "llm",
    "claude-code",
    "codex",
    "opencode",
    "qwen-code",
    "github-copilot",
    "goose",
    "pi",
    "kilo-code",
    "kimi-code",
    "hermes",
    "hermes-agent",
    "openrouter",
    "openai",
    "responses-api",
    "api-proxy",
    "typescript",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxe/agentO.git"
  },
  "bugs": {
    "url": "https://github.com/emaxe/agentO/issues"
  },
  "homepage": "https://github.com/emaxe/agentO#readme",
  "type": "module",
  "bin": {
    "agento": "dist/bin/agento.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "AGENTS.md",
    "README.ru.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build && node dist/bin/agento.js --version && npm test",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src bin",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.43",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.3",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
